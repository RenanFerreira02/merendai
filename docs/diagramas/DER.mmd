    PROPOSTA ||--|{ PARTICIPANTE_MUTIRAO : "reune"
    PRODUTOR ||--o{ PARTICIPANTE_MUTIRAO : "participa"

    PROPOSTA     ||--|{ ITEM_PROPOSTA : "oferta"
    ITEM_CHAMADA ||--o{ ITEM_PROPOSTA : "atende"
    PRODUTOR     ||--o{ ITEM_PROPOSTA : "entrega"

