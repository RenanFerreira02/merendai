    USUARIO ||--o| PRODUTOR : "e um"

    TECNICO ||--o{ PRODUTOR : "cadastra e acompanha"
    TECNICO ||--o{ PROPOSTA : "revisa"

    PRODUTOR ||--o{ PRODUCAO : "planta"
    PRODUTO  ||--o{ PRODUCAO : "e plantado"
    PRODUTO  ||--o{ ITEM_CHAMADA : "e pedido"

    CHAMADA ||--|{ ITEM_CHAMADA : "contem"
    CHAMADA ||--o{ PROPOSTA : "recebe"

    ITEM_CHAMADA ||--o{ PROSPECT : "gera (matching PL/SQL)"
    PRODUTOR     ||--o{ PROSPECT : "e candidato"

